# Easypanel production env
DATABASE_URL=postgres://usuario:senha@host:5432/banco
PAYLOAD_SECRET=gere-uma-chave-forte-com-32-caracteres-ou-mais
NEXT_PUBLIC_SITE_URL=https://cavalcantealbuquerque.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5584991243985

# Server-to-server secrets
CRON_SECRET=gere-uma-chave-forte-para-cron
REVALIDATE_SECRET=gere-uma-chave-forte-para-revalidate
N8N_WEBHOOK_SECRET=gere-uma-chave-forte-para-n8n
INTERNAL_API_SECRET=gere-uma-chave-forte-para-api-interna

# Payload native jobs / automations
# Ative em apenas uma instancia do app para evitar execucoes duplicadas.
PAYLOAD_JOBS_AUTORUN=false
PAYLOAD_JOBS_ACCESS_SECRET=gere-uma-chave-forte-para-jobs
PAYLOAD_JOBS_BASE_URL=https://cavalcantealbuquerque.com.br
PAYLOAD_JOBS_RUN_CRON=* * * * *
PAYLOAD_JOBS_RUN_LIMIT=10
PAYLOAD_JOBS_NEWS_CRON=0 */6 * * *
PAYLOAD_JOBS_DEADLINES_CRON=0 8 * * *

# Public/contact
PUBLIC_CONTACT_EMAIL=contato@cavalcantealbuquerque.com.br
PUBLIC_CONTACT_PHONE=(84) 99124-3985
CONTACT_EMAIL=contato@cavalcantealbuquerque.com.br
CONTACT_EMAIL_2=

# Email provider
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cavalcante Albuquerque <nao-responda@cavalcantealbuquerque.com.br>

# AI/external APIs
ANTHROPIC_API_KEY=
DATAJUD_API_KEY=

# Optional bootstrap admin, use only while running bootstrap:new-db
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Optional one-time deploy helpers for Docker/Easypanel
RUN_PREFLIGHT_ON_START=false
RUN_MIGRATIONS_ON_START=false
BOOTSTRAP_NEW_DB_ON_START=false
DB_WAIT_SECONDS=60
